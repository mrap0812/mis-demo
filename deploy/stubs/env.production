# ==== Konfigurasi server situs Masjid Imam Syafi'i Banjarmasin ====
# WAJIB diisi: bagian DATABASE di bawah (dari cPanel > MySQL Databases).
# Jangan bagikan file ini kepada siapa pun. APP_KEY dibuat unik untuk paket ini.

APP_NAME="Masjid Imam Syafi'i Banjarmasin"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://www.mis.id
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ---- DATABASE (isi sesuai cPanel) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=misid_ISI_NAMA_DATABASE
DB_USERNAME=misid_ISI_NAMA_PENGGUNA
DB_PASSWORD=ISI_KATA_SANDI_DATABASE

# Alamat panel admin: https://www.mis.id/kelola-mis
# Boleh diganti kata lain (huruf kecil, angka, tanda minus). Mengganti alamat ini mengurangi serangan tebak login otomatis.
ADMIN_PATH=kelola-mis

# Token sekali pakai untuk membuat akun admin pertama di https://www.mis.id/pasang
# Setelah akun admin dibuat, halaman /pasang mati sendiri. Baris ini boleh dihapus sesudahnya.
SETUP_TOKEN=__SETUP_TOKEN__

# Gambar unggahan disimpan di public_html/storage (tanpa symlink).
PUBLIC_STORAGE_IN_WEBROOT=true
BACKUP_KEEP=14

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mis.id"
MAIL_FROM_NAME="${APP_NAME}"
