# Situs Masjid Imam Syafi'i Banjarmasin (Laravel). Menggantikan .htaccess WordPress lama.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Paksa HTTPS. Aktifkan (hapus tanda #) setelah memastikan https://www.mis.id terbuka normal.
    # Jangan aktifkan bila domain memakai Cloudflare mode SSL "Flexible" (bisa berputar tanpa henti).
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Samakan ke www.mis.id (alamat resmi sejak WordPress), agar tidak ada dua versi situs di Google.
    RewriteCond %{HTTP_HOST} ^mis\.id$ [NC]
    RewriteRule ^ https://www.mis.id%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Tolak file tersembunyi (.env, .git, dll.), kecuali .well-known untuk sertifikat SSL.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Buang garis miring di akhir alamat, kecuali folder sungguhan.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Kompresi teks
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json text/calendar application/xml text/xml
</IfModule>

# Cache peramban untuk aset. CSS/JS situs memakai ?v=, jadi aman di-cache lama.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
